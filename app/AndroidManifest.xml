<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.aliveclean" android:versionCode="100" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.SET_WALLPAPER"/>
  <uses-permission android:name="android.permission.AMBIENT_WALLPAPER"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <uses-feature android:name="android.software.live_wallpaper" android:required="true"/>
  <queries>
    <intent><action android:name="android.service.wallpaper.CHANGE_LIVE_WALLPAPER"/></intent>
    <intent><action android:name="android.service.wallpaper.LIVE_WALLPAPER_CHOOSER"/></intent>
    <intent><action android:name="android.intent.action.SET_WALLPAPER"/></intent>
    <package android:name="com.android.wallpaper.livepicker"/>
    <package android:name="com.google.android.apps.wallpaper"/>
    <package android:name="com.android.wallpaper"/>
    <package android:name="com.android.thememanager"/>
    <package android:name="com.android.systemui"/>
    <package android:name="com.miui.aod"/>
    <package android:name="com.oplus.wallpapers"/>
    <package android:name="org.lsposed.manager"/>
    <package android:name="com.heytap.themestore"/><package android:name="com.oplus.themestore"/>
    <provider android:authorities="com.oplus.aod.AodMachineHelperProvider"/>
    <package android:name="com.coloros.gallery3d"/><package android:name="com.oplus.gallery3d"/>
    <package android:name="com.android.documentsui"/><package android:name="com.google.android.documentsui"/>
    <intent><action android:name="android.intent.action.PICK"/><data android:mimeType="image/*"/></intent>
    <intent><action android:name="android.intent.action.OPEN_DOCUMENT"/><data android:mimeType="image/*"/></intent>
  </queries>
  <application android:label="Alive 壁纸" android:icon="@drawable/alive_icon" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:extractNativeLibs="true" android:supportsRtl="true" android:forceQueryable="true">
    <meta-data android:name="xposedmodule" android:value="true"/>
    <meta-data android:name="xposedminversion" android:value="82"/>
    <meta-data android:name="xposeddescription" android:value="Alive 壁纸 · ColorOS / HyperOS 息屏与一镜到底适配"/>
    <meta-data android:name="xposedscope" android:resource="@array/xposed_scope"/>
        <activity android:screenOrientation="portrait" android:name=".HomeActivity" android:exported="true" android:theme="@style/Theme.Clean.Home">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <activity android:screenOrientation="portrait" android:name=".MainActivity" android:exported="true" android:theme="@style/Theme.Clean.Editor"/>
    <activity android:screenOrientation="portrait" android:name=".FrameCropActivity" android:exported="false" android:theme="@android:style/Theme.Material.NoActionBar"/>
    <activity android:screenOrientation="portrait" android:name=".PhotoCropActivity" android:exported="false" android:theme="@android:style/Theme.Material.NoActionBar"/>
    <provider android:name=".SceneProvider" android:authorities="org.aliveclean.scene" android:exported="true" android:permission="android.permission.STATUS_BAR"/>
    <provider android:name=".NativeClockStatusProvider" android:authorities="org.aliveclean.clock.runtime" android:exported="true" android:directBootAware="true"/>
    <service android:name=".CleanWallpaper" android:exported="true" android:permission="android.permission.BIND_WALLPAPER">
      <intent-filter><action android:name="android.service.wallpaper.WallpaperService"/></intent-filter>
      <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper"/>
    </service>
  </application>
</manifest>
